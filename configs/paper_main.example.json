{
  "train": {
    "log_path" : "outputs/logs/train.log",
    "epochs": 40,
    "amp": false,
    "grad_clip": 1.0,
    "save_every": 1,
    "print_every": 1,
    "resume_dir": "outputs/checkpoints",
    "ckpt_dir": "outputs/checkpoints",
    "tensorboard_dir": "outputs/tensorboard",
    "lr": 0.00001,
    "data": {
      "data_path": "path/to/train.jsonl",
      "valid_data_path": "path/to/validation.jsonl",
      "max_tokens": 1024,
      "shuffle": true,
      "seed": 1234,
      "budget_mode": "protein+ligand",
      "drop_remainder": false
    },
    "criterion": {
      "weights": {
        "lm": 0.5,
        "coord": 1.0,
        "pocket_coord": 1.0,
        "pocket_gate": 0.5,
        "pocket_gate_l2": 0.0
      },
      "pocket_target": "all",
      "ignore_index": -100,
      "smoothl1_beta": 1.0,
      "coord_scale": 1.0,
      "pocket_ratio": 0.17

    }
  },
  "generation": {},
  "model": {
    "ablation": {
        "wo_PBA": false
    },
    "pegm": {
      "device": "cuda",
      "pad_idx": 32,
      "embeding_dim": 1280,
      "pba_layer_num": 3
    },
    "nae": {
      "device": "cuda",
      "esm_path": "path/to/esm2_t33_650M_UR50D.pt",
      "esm_model": "esm2_t33_650M_UR50D",
      "ec_vocab_sizes": [
        8,
        100,
        100,
        400
      ],
      "egnn_layers": 3,
      "egnn_hidden_nf": 1280,
      "egnn_attention": true,
      "egnn_coords_agg": "mean",
      "egnn_normalize": false,
      "egnn_tanh": false,
      "k": 30,
      "egnn_steps": 3,
      "randwalk_step": 3.75,
      "merge_encoder_embed": false,
      "merge_entropy_feat": false
    },
    "sne": {
      "in_node_nf": 5,
      "hidden_nf": 1280,
      "out_dim": 1280,
      "n_layers": 3,
      "k": 16,
      "attention": true,
      "coords_agg": "sum",
      "normalize": false,
      "tanh": false,
      "pooling": "mean",
      "device": "cuda"
    },
    "pba": {
      "res_dim": 1280,
      "lig_dim": 1280,
      "attn_dim": 1280,
      "rbf_k": 16,
      "rbf_cutoff": 20.0,
      "pocket_threshold": 0.03,
      "allow_self_res_attn": true,
      "coord_gate_tanh": true,
      "device": "cuda"
    },
    "enzyme_head": {
      "device": "cuda",
      "hidden_dim": 1280,
      "num_classes": 20,
      "dropout": 0.1,
      "use_pocket_as_feature": false
    }
  }
}
